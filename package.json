{
  "name": "ruby-online-ide",
  "version": "1.0.0",
  "description": "Ruby Online IDE with multiple version support",
  "main": "index.js",
  "scripts": {
    "front": "cd frontend && npm start",
    "back": "cd backend && node server.js",
    "dev": "concurrently \"npm run back\" \"npm run front\"",
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "test": "cd backend && npm test"
  },
  "keywords": [
    "ruby",
    "ide",
    "online",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
